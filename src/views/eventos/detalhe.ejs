<div id="mensagem" class="mensagem" aria-live="polite" hidden></div>
<article class="cartao evento detalhe" id="evento-<%= evento.id %>">
  <span class="etiqueta"><%= evento.categoria ? evento.categoria.nome : '' %></span>
  <h1><%= evento.titulo %></h1>
  <p class="info"><%= new Date(evento.data + 'T12:00:00').toLocaleDateString('pt-BR') %> · <%= evento.local %></p>
  <p><%= evento.descricao %></p>
  <p class="vagas">Vagas: <span class="js-ocupadas"><%= evento.ocupadas %></span>/<%= evento.vagas %></p>
  <div class="js-acao"><%- include('../partials/botaoInscricao', { ev: evento }) %></div>

  <% if (usuario && usuario.papel === 'admin') { %>
    <div class="acoes-admin">
      <a href="/eventos/<%= evento.id %>/editar" class="botao botao-secundario">Editar</a>
      <form action="/eventos/<%= evento.id %>/excluir" method="POST" class="form-inline js-confirmar" data-pergunta="Excluir este evento e todas as inscrições?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="botao botao-perigo">Excluir</button>
      </form>
    </div>
  <% } %>
</article>
<p><a href="/eventos">← Voltar aos eventos</a></p>
