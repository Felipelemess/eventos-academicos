# Copie este arquivo para .env (ou rode "npm run configurar"). NUNCA suba o .env para o GitHub.
PORT=3000
SESSION_SECRET=

# Banco PostgreSQL ou MySQL:
#   DATABASE_URL=postgres://usuario:senha@servidor:5432/banco
#   DATABASE_URL=mysql://usuario:senha@servidor:3306/banco
DATABASE_URL=

# Opcional: true/false. Se vazio, liga SSL para bancos na nuvem e desliga para banco local.
DB_SSL=

# Usuários criados automaticamente no primeiro start (banco vazio)
ADMIN_EMAIL=
ADMIN_SENHA=
TESTE_EMAIL=
TESTE_SENHA=
